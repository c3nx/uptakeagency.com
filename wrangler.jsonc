{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptakeagency-com",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  // Apex A kaydı yerinde kalır; route tüm istekleri kenarda yakalayıp origin'e gitmeden Worker'a verir
  "routes": [{ "pattern": "uptakeagency.com/*", "zone_name": "uptakeagency.com" }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
