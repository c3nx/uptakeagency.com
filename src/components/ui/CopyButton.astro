---
interface Props {
  text: string;
  label: string;
  copiedLabel: string;
}

const { text, label, copiedLabel } = Astro.props;
---

<span class="relative inline-flex items-center" data-copy-root>
  <button
    type="button"
    class="inline-flex h-9 w-9 items-center justify-center rounded-md text-text-muted transition-colors hover:text-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
    aria-label={label}
    title={label}
    data-copy-text={text}
    data-copied-label={copiedLabel}
  >
    <svg data-icon-copy class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
    </svg>
    <svg data-icon-check class="hidden h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
    </svg>
  </button>
  <span class="absolute left-1/2 top-full mt-1 -translate-x-1/2 whitespace-nowrap text-sm font-medium text-brand-600" aria-live="polite" data-copy-status></span>
</span>

<script>
  import { copyText } from "../../lib/copy-text";

  const GOSTERIM_MS = 2000;

  document.querySelectorAll<HTMLElement>("[data-copy-root]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>("button[data-copy-text]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    const iconCopy = root.querySelector<SVGElement>("[data-icon-copy]");
    const iconCheck = root.querySelector<SVGElement>("[data-icon-check]");
    if (!button || !status || !iconCopy || !iconCheck) return;

    let timer: ReturnType<typeof setTimeout> | undefined;

    const reset = () => {
      status.textContent = "";
      iconCheck.classList.add("hidden");
      iconCopy.classList.remove("hidden");
    };

    // Kopyalanamazsa kullanıcı Ctrl+C yapabilsin diye bağlantı metnini seç
    const selectLinkText = () => {
      const link = root.closest("[data-copy-group]")?.querySelector("a");
      if (!link) return;
      const range = document.createRange();
      range.selectNodeContents(link);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };

    button.addEventListener("click", async () => {
      clearTimeout(timer);
      const ok = await copyText(button.dataset.copyText ?? "");
      if (!ok) {
        reset();
        selectLinkText();
        return;
      }
      iconCopy.classList.add("hidden");
      iconCheck.classList.remove("hidden");
      // Aynı metin tekrar duyurulsun diye önce boşalt
      status.textContent = "";
      requestAnimationFrame(() => {
        status.textContent = button.dataset.copiedLabel ?? "";
      });
      timer = setTimeout(reset, GOSTERIM_MS);
    });
  });
</script>
