---
import Button from "@/components/ui/Button.astro";
import { GA_MEASUREMENT_ID, assertGaMeasurementId } from "@/config/analytics";
import { getLocalizedPath, t } from "@/i18n";

interface Props {
  locale: "en" | "tr";
}

const { locale } = Astro.props;
const i18n = t(locale);

// Build sırasında doğrula: geçersiz kimlikle derleme durur
assertGaMeasurementId(GA_MEASUREMENT_ID);

const privacyHref = getLocalizedPath("/privacy-policy", locale);
---

{/* Varsayılan gizli: JS kapalıysa bant da GA de yok */}
{/* Kutu biçimi yalnız genişlik>=640 VE yükseklik>=500 iken (bkz. tailwind.config.mjs "box" ekranı); aksi halde alttaki tam genişlik şerit kalır */}
<div
  data-consent-banner
  role="region"
  aria-labelledby="consent-banner-title"
  aria-describedby="consent-banner-description"
  class="hidden fixed inset-x-0 bottom-0 z-50 max-h-[80vh] overflow-y-auto border-t border-surface-border bg-surface-raised/95 backdrop-blur box:inset-x-auto box:bottom-5 box:left-5 box:w-[26rem] box:max-w-[calc(100vw-2.5rem)] box:rounded-xl box:border box:shadow-lg"
>
  <div class="flex flex-col gap-4 px-4 py-4 sm:px-6">
    <div class="min-w-0">
      <p
        id="consent-banner-title"
        tabindex="-1"
        class="font-mono text-sm font-semibold text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:ring-offset-2 focus:ring-offset-surface-raised rounded-sm"
      >
        <span class="text-brand-400">//</span>
        {i18n.consent.title}
      </p>
      <p id="consent-banner-description" class="mt-1 text-sm leading-relaxed text-text-secondary">
        {i18n.consent.description}{" "}
        <a
          href={privacyHref}
          class="rounded-sm text-brand-400 underline underline-offset-2 transition-colors hover:text-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:ring-offset-2 focus:ring-offset-surface-raised"
        >
          {i18n.consent.privacy_link}
        </a>
      </p>
    </div>
    {/* Düğmeler her genişlikte grid-cols-2: eşit genişlik, yan yana */}
    <div class="grid grid-cols-2 gap-3">
      <Button
        type="button"
        variant="secondary"
        size="md"
        class="w-full"
        data-consent-reject
      >
        {i18n.consent.reject}
      </Button>
      <Button
        type="button"
        variant="secondary"
        size="md"
        class="w-full"
        data-consent-accept
      >
        {i18n.consent.accept}
      </Button>
    </div>
  </div>
</div>

<script>
  import {
    applyStoredConsent,
    disableAnalytics,
    enableAnalytics,
    initConsentSync,
    initMailtoTracking,
    readStoredConsent,
    storeConsent,
  } from "@/lib/analytics-client";

  const banner = document.querySelector<HTMLElement>("[data-consent-banner]");
  const title = document.getElementById("consent-banner-title");
  // Bandı yeniden açan buton, kapanınca odak ona döner
  let opener: HTMLElement | null = null;

  function showBanner(source: HTMLElement | null) {
    if (!banner) return;
    opener = source;
    banner.classList.remove("hidden");
    if (source) title?.focus();
  }

  function hideBanner(returnFocus = true) {
    if (!banner) return;
    banner.classList.add("hidden");
    if (returnFocus) opener?.focus();
    opener = null;
  }

  // Kayıtlı tercih yoksa GA yüklenmez, bant gösterilir
  const storedChoice = applyStoredConsent();
  initMailtoTracking();
  if (storedChoice === null) showBanner(null);

  banner?.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
    storeConsent("granted");
    enableAnalytics();
    hideBanner();
  });

  banner?.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
    // Sıra önemli: disableAnalytics sayfayı yeniden yükleyebilir,
    // tercih ondan önce yazılmış olmalı ki yeni sayfa "denied" okusun
    storeConsent("denied");
    disableAnalytics();
    hideBanner();
  });

  // Footer'daki "Çerez tercihleri" butonu bandı yeniden açar
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const reopener = target.closest<HTMLElement>("[data-consent-reopen]");
    if (!reopener) return;
    showBanner(reopener);
  });

  // Escape yalnızca kayıtlı tercih varken kapatır, ilk ziyarette bant kapanmaz
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (!banner || banner.classList.contains("hidden")) return;
    if (readStoredConsent() === null) return;
    hideBanner();
  });

  // Diğer sekmeler ve bfcache dönüşü ile uzlaştır, odağı çalma
  initConsentSync((choice) => {
    if (choice === null) showBanner(null);
    else hideBanner(false);
  });
</script>
