---
import Container from "@/components/ui/Container.astro";
import { t, getLocalizedPath } from "@/i18n";

interface Props {
  locale: "en" | "tr";
}

const { locale } = Astro.props;
const i18n = t(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-surface-raised">
  <Container>
    <!-- SEO-rich about + services -->
    <div class="py-8 border-b border-surface-border">
      <div class="flex flex-col gap-6 md:flex-row md:justify-between">
        <div class="max-w-lg">
          <a href={getLocalizedPath("/", locale)} class="flex items-center gap-2 font-mono text-sm text-text-primary mb-3">
            <img src="/favicon.svg" alt="Uptake Agency Logo" class="h-5 w-5" />
            <span class="font-semibold">uptake-agency</span>
          </a>
          <p class="text-sm text-text-secondary leading-relaxed">
            {i18n.footer.about}
          </p>
        </div>
        <div class="flex flex-col gap-4 md:items-end">
          <p class="text-xs text-text-muted">info@uptakeagency.com</p>
          <p class="text-xs text-text-muted">Istanbul, Turkey</p>
          <a
            href="https://www.linkedin.com/company/uptake-agency"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-sm text-xs text-text-muted transition-colors hover:text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:ring-offset-2 focus:ring-offset-surface-raised"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-text-muted">
        {i18n.footer.services_keywords}
      </p>
    </div>

    <!-- Copyright + links -->
    <div class="flex flex-col items-center justify-between gap-4 py-6 md:flex-row">
      <p class="text-sm text-text-muted font-mono">
        <span class="text-text-secondary">&copy; {year}</span> Uptake Agency <span class="text-text-muted">// {i18n.footer.rights}</span>
      </p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a
          href={getLocalizedPath("/privacy-policy", locale)}
          class="text-sm text-text-muted hover:text-text-primary transition-colors"
        >
          {i18n.footer.privacy}
        </a>
        <a
          href={getLocalizedPath("/terms-of-service", locale)}
          class="text-sm text-text-muted hover:text-text-primary transition-colors"
        >
          {i18n.footer.terms}
        </a>
        <a
          href={getLocalizedPath("/data-deletion", locale)}
          class="text-sm text-text-muted hover:text-text-primary transition-colors"
        >
          {i18n.footer.data_deletion}
        </a>
        {/* Onay bandını yeniden açar */}
        <button
          type="button"
          data-consent-reopen
          class="rounded-sm text-sm text-text-muted transition-colors hover:text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:ring-offset-2 focus:ring-offset-surface-raised"
        >
          {i18n.consent.manage}
        </button>
      </div>
    </div>
  </Container>
</footer>
