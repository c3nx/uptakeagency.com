---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection } from "astro:content";
import { hasAlternate } from "@/lib/alternate";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => p.data.locale === "en")
    .map((post) => ({
      params: { slug: post.slug.replace("en/", "") },
      props: {
        post,
        // Karşı dilde aynı slug'lı kayıt var mı (hreflang ve dil anahtarı için)
        alternateExists: hasAlternate(
          posts.map((e) => e.slug),
          post.slug.replace("en/", ""),
          "en",
        ),
      },
    }));
}

const { post, alternateExists } = Astro.props;
const { Content } = await post.render();
const locale = "en";
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  locale={locale}
  date={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
  canonicalPath={`/blog/${post.slug.replace("en/", "")}`}
  alternateExists={alternateExists}
>
  <Content />
</BlogLayout>
