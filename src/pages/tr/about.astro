---
import PageLayout from "@/layouts/PageLayout.astro";
import Container from "@/components/ui/Container.astro";
import { t } from "@/i18n";

const locale = "tr";
const i18n = t(locale);

const timeline = [
  { year: "2009", title: "Teknoloji Kariyeri", desc: "Teknoloji altyapısı ve sistem yönetimi alanında kariyer başlangıcı." },
  { year: "2014", title: "Oyun Sektörü", desc: "Büyük ölçekli mekanlar için altyapı inşa ederek oyun ve eğlence sektörüne giriş." },
  { year: "2018", title: "Kurumsal Ortaklıklar", desc: "Kurumsal düzeyde çözümler için Intel, NVIDIA ve MSI ile ortaklıklar kuruldu." },
  { year: "2022", title: "Yapay Zeka Dönüşümü", desc: "Chatbot'lardan tam otomasyon sistemlerine kadar müşteri projelerine yapay zeka çözümlerinin entegrasyonuna başlanıldı." },
  { year: "2024", title: "Uptake Agency", desc: "Uluslararası müşterilere teknoloji danışmanlığı ve yapay zeka çözümleri sunmak için Uptake Agency kuruldu." },
];
---

<PageLayout
  title="Hakkımızda"
  description="Uptake Agency ve kurucusu Cengiz Selçuk'un 15+ yıllık teknoloji deneyimi hakkında bilgi edinin."
  locale={locale}
  canonicalPath="/about"
>
  <section class="py-section-mobile lg:py-section">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h1 class="text-display font-bold tracking-tight text-text-primary">
          {i18n.about.title}
        </h1>
        <p class="mt-6 text-xl text-text-secondary leading-relaxed">
          {i18n.about.founder_bio}
        </p>
      </div>
    </Container>
  </section>

  <section class="border-t border-surface-border py-section-mobile lg:py-section">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="text-headline font-bold tracking-tight text-text-primary">
          {i18n.about.founder_title}
        </h2>
        <div class="mt-8 space-y-6 text-lg text-text-secondary leading-relaxed">
          <p>
            Cengiz Selçuk, altyapı mühendisliği, yazılım geliştirme ve yapay zeka entegrasyonu alanlarında 15 yılı aşkın deneyime sahip bir teknoloji lideridir. Kariyerine kurumsal BT alanında başlamış ve büyük ölçekli teknoloji sistemleri kurma ve yönetme konusunda derin uzmanlık geliştirmiştir.
          </p>
          <p>
            Oyun eğlence sektöründe Cengiz, büyük mekanların teknik altyapısını yönetmiş, kurumsal düzeyde bilişim çözümleri sunmak için Intel, NVIDIA ve MSI ile ortaklıklar kurmuştur. Bu deneyim, teknolojinin geleneksel işletmeleri nasıl dönüştürebileceğine dair benzersiz bir bakış açısı sağlamıştır.
          </p>
          <p>
            Bugün Uptake Agency aracılığıyla Cengiz, altyapı uzmanlığını en son yapay zeka yetenekleriyle birleştirerek dünya genelindeki işletmelerin büyüme için teknolojiden yararlanmasına yardımcı olmaktadır. Özel LLM çözümlerinden full-stack platform geliştirmeye kadar, Uptake Agency pratik ve ölçülebilir sonuçlara odaklanan uçtan uca teknoloji danışmanlığı sunmaktadır.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-surface-raised py-section-mobile lg:py-section">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold text-text-primary mb-12">Kariyer Zaman Çizelgesi</h2>
        <div class="space-y-8">
          {timeline.map((item) => (
            <div class="flex gap-8">
              <div class="flex-shrink-0 w-20 text-right">
                <span class="text-sm font-bold text-brand-600">{item.year}</span>
              </div>
              <div class="flex-1 border-l-2 border-surface-border pl-8 pb-2">
                <h3 class="font-semibold text-text-primary">{item.title}</h3>
                <p class="mt-1 text-text-secondary">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="py-section-mobile lg:py-section">
    <Container>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="text-5xl font-bold text-text-primary">15+</div>
          <div class="mt-2 text-text-secondary">{i18n.about.stats.experience}</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-text-primary">$2M+</div>
          <div class="mt-2 text-text-secondary">{i18n.about.stats.revenue}</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-text-primary">4</div>
          <div class="mt-2 text-text-secondary">{i18n.about.stats.partners}</div>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
