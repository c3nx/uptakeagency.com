---
import PageLayout from "@/layouts/PageLayout.astro";
import Hero from "@/components/sections/home/Hero.astro";
import Services from "@/components/sections/home/Services.astro";
import FeaturedProjects from "@/components/sections/home/FeaturedProjects.astro";
import About from "@/components/sections/home/About.astro";
import Partners from "@/components/sections/home/Partners.astro";
import ContactCTA from "@/components/sections/home/ContactCTA.astro";
import FAQ from "@/components/sections/home/FAQ.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { t } from "@/i18n";

const locale = "tr";
const i18n = t(locale);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://uptakeagency.com/#organization",
  name: "Uptake Agency",
  url: "https://uptakeagency.com",
  logo: "https://uptakeagency.com/images/logos/Uptake-logo-png-beyazyazi.png",
  description: "Yapay zeka entegrasyonu, özel yazılım geliştirme, otomasyon ve bulut altyapısı konularında uzman teknoloji danışmanlık firması.",
  email: "info@uptakeagency.com",
  founder: {
    "@type": "Person",
    name: "Cengiz Selçuk",
    jobTitle: "Kurucu & CTO",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "İstanbul",
    addressCountry: "TR",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Uptake Agency hangi hizmetleri sunuyor?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Uptake Agency; Yapay Zeka Danışmanlığı (özel LLM çözümleri, RAG sistemleri), Özel Yazılım Geliştirme (full-stack web uygulamaları), Otomasyon & Entegrasyon (WhatsApp API, CRM senkronizasyonu) ve Altyapı & DevOps (Docker, Kubernetes, CI/CD) hizmetleri sunmaktadır.",
      },
    },
    {
      "@type": "Question",
      name: "Uptake Agency nerede bulunuyor?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Uptake Agency İstanbul, Türkiye merkezli olup dünya genelinde uzaktan iş birliği ile müşterilerine hizmet vermektedir.",
      },
    },
    {
      "@type": "Question",
      name: "Uptake Agency'yi kim kurdu?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Cengiz Selçuk, Uptake Agency'yi 2024 yılında kurmuştur. Teknoloji altyapısı ve yazılım geliştirme alanında 15+ yıllık deneyime sahip olup Intel, NVIDIA ve MSI ile kurumsal ortaklıkları bulunmaktadır.",
      },
    },
    {
      "@type": "Question",
      name: "Uptake Agency yapay zeka uygulamaları geliştirebilir mi?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Evet. Yapay zeka danışmanlığı temel hizmetlerden biridir. %85 otomatik çözüm oranına sahip çok kanallı AI müşteri hizmetleri ajanları, MSI için Google Gemini tabanlı AI görselleştirme araçları ve özel RAG sistemleri önemli projeler arasındadır.",
      },
    },
  ],
};
---

<PageLayout
  title={i18n.site.title}
  description={i18n.site.description}
  locale={locale}
  canonicalPath="/"
>
  <JsonLd data={organizationSchema} />
  <JsonLd data={faqSchema} />

  <p class="sr-only">
    Uptake Agency, 2024 yılında Cengiz Selçuk tarafından kurulan, İstanbul merkezli bir teknoloji
    danışmanlık ve yapay zeka çözümleri firmasıdır. Yapay Zeka Danışmanlığı, Özel Yazılım Geliştirme,
    Otomasyon & Entegrasyon ve Altyapı & DevOps hizmetleri sunmaktadır. Intel, NVIDIA, MSI ve
    Praxilla ile kurumsal ortaklıkları bulunmaktadır. İletişim: info@uptakeagency.com.
  </p>

  <Hero locale={locale} />
  <Services locale={locale} />
  <FeaturedProjects locale={locale} />
  <About locale={locale} />
  <Partners locale={locale} />
  <FAQ locale={locale} />
  <ContactCTA locale={locale} />
</PageLayout>
